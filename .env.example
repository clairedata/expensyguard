# ==============================================================================
# FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================

# URL de base de l'API LLM (OpenAI ou Ollama local)
LLM_BASE_URL="https://api.openai.com/v1"

# Clé secrète de l'API LLM pour l'authentification
LLM_API_KEY="votre_cle_api_ici"

# Modèle LLM à utiliser pour l'extraction structurée (ex: gpt-4o-mini, llama3)
LLM_MODEL="gpt-4o-mini"

# URL publique de l'API SIRENE / Recherche Entreprises de l'État français
REGISTRY_API_URL="https://recherche-entreprises.api.gouv.fr"

# Plafond de dépense autorisé pour les repas en euros (règle métier)
MAX_MEAL_EXPENSE_EUR="45.00"

# Chemin vers la base de données SQLite locale pour l'historique et doublons
DATABASE_PATH="expensyguard.db"

# Jeton d'authentification du Bot Telegram fourni par @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
